{
  "name": "human-resource-management",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --outfile=bundle.js --loader:.jsx=jsx --jsx=automatic --define:process.env.NODE_ENV=\"'production'\"",
    "watch": "esbuild src/main.jsx --bundle --outfile=bundle.js --loader:.jsx=jsx --jsx=automatic --define:process.env.NODE_ENV=\"'production'\" --watch",
    "serve": "node server.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
